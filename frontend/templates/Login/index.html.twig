{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('login') }}
{% endblock %}

{% block title %}Iniciar sesión{% endblock %}

{% block body %}
<div class="login-overlay">
    <div class="login-container">
        <div class="login-title">Iniciar sesión</div>

        {{ form_start(loginForm) }}

            <div class="form-group">
                {{ form_label(loginForm.email) }}
                {{ form_widget(loginForm.email, { attr: { class: 'form-input' } }) }}
            </div>

            <div class="form-group">
                {{ form_label(loginForm.password) }}
                {{ form_widget(loginForm.password, { attr: { class: 'form-input' } }) }}
            </div>

            {{ form_widget(loginForm.submit, { attr: { class: 'btn-primary' } }) }}

        {{ form_end(loginForm) }}
    </div>
</div>
{% endblock %}
