<div
	class="layout" data-controller="media-stream" data-media-stream-target="container">

	<!-- PANEL LATERAL -->
	<div class="side-panel">


		<div id="iframe-container" data-media-stream-target="iframeContainer"></div>
		<div class="side-header">
			<span class="side-header-icon">⚡</span>
			<span class="side-header-title">Streams</span>
		</div>

		<div class="stream-list">
			<table class="stream-table">
				<thead>
					<tr>
						<th></th>
						<th>Language</th>
						<th>Server</th>
						<th>Quality</th>
						<th>Link</th>
						<th>Author</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{# ADMIN LINK #}
					<tr>
						<td></td>
						<td>
							<img src="{{ asset('build/images/languages/vo2.png') }}" alt="{{ 'VOS' }}">
						</td>
						<td>{{ 'STREAMIMDB' }}</td>
						<td>{{ '-' }}</td>
						<td>
							<a href="https://www.playimdb.com/en-en/title/{{ movieId }}" target="_blank" rel="noopener noreferrer">
								<button class="btn btn-primary">
									{{ 'mediaFile.table.watch-now'|trans }}
								</button>
							</a>
						</td>
						<td>{{ '@admin' }}</td>
						<td class="pointer" title="{{ 'app.mediaFile.report-link'|trans }}">
							<button class="flag-btn" aria-label="{{ 'app.mediaFile.report-link'|trans }}" title="{{ 'app.mediaFile.report-link'|trans }}">
								<svg width="18" height="18" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="flag-icon-svg">
									<path d="M4 21V4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
									<path d="M5 5.5h11l-2.2 5L18 16H6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
								</svg>
							</button>
						</td>

					</tr>
					{% if links['results'] is defined and links %}
						{% for link in links['results'] %}
							<tr data-media-stream-link-id-value="{{ link.id }}" data-media-stream-find-link-url-value="{{ path('app.stream-content', {'linkId': link.id, 'mediaId': link.movie.movieId}) }}">
								<td>
									<svg width="18" height="18" viewbox="0 0 24 24" fill="#FFD700">
										<path d="M12 .587l3.668 7.568L24 9.748l-6 5.848L19.335 24 12 19.897 4.665 24 6 15.596 0 9.748l8.332-1.593z"/>
									</svg>
								</td>

								<td>
									<img src="{{ asset('build/images/languages/' ~ link.language|lower ~ '.png') }}" alt="{{ link.language }}">
								</td>
								<td>{{ link.server }}</td>
								<td>{{ link.quality }}p</td>
								<td>
									<button class="btn btn-primary" value="{{ link.id }}" data-action="media-stream#openLink">
										{{ 'mediaFile.table.watch-now'|trans }}
									</button>
								</td>
								<td>{{ '@' ~ link.user.username }}</td>
								<td>
									<button class="btn btn-ghost flag-btn" title="{{ 'app.mediaFile.report-link'|trans }}" aria-label="{{ 'app.mediaFile.report-link'|trans }}">
										<svg width="18" height="18" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="flag-icon-svg">
											<path d="M4 21V4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
											<path d="M5 5.5h10.5l-2 4.5L17 15H6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
										</svg>
									</button>
								</td>

							</tr>
						{% endfor %}
					{% endif %}
				</tbody>
			</table>

			{# NO STREAMS #}
			<div class="no-streams">
				<span class="no-streams-icon">📦</span>
				<p class="no-streams-text">{{ 'mediaFile.info.no-media'|trans }}</p>

				<button class="btn btn--addons" data-action="movie-links#loadForm">
					Add Link!
				</button>

			</div>
		</div>

	</div>

</div>
